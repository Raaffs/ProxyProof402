pragma solidity ^0.8.20;

import "forge-std/Script.sol";
import "@reclaimprotocol/solidity-sdk/contracts/Reclaim.sol";
import "../src/validation_registry.sol";

contract Script is Script {
    function run() external {
        uint256 deployerPrivateKey = vm.envUint("PRIVATE_KEY");

        vm.startBroadcast(deployerPrivateKey);

        Reclaim reclaimVerifier = new Reclaim();
        console.log("Reclaim Verifier deployed at:", address(reclaimVerifier));

        ValidationRegistry validationRegistry = new ValidationRegistry(address(reclaimVerifier));
        console.log("ValidationRegistry deployed at:", address(validationRegistry));

        vm.stopBroadcast();
    }
}